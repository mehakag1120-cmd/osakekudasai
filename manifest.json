{
  "manifest_version": 3,
  "name": "Rikimashou!",
  "version": "1.0.0",
  "description": "Real-time tab audio transcription and morphological analysis to maximize Japanese learning.",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://jotoba.de/*",
    "https://jisho.org/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Rikimashou! Subtitles",
    "default_icon": "icons/icon32.png"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
