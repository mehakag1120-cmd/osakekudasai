# Rikimashou! Environment Variables Template
# Copy this file to .env and insert your API keys.

# Groq Cloud API Key (Get a free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Get a key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here
